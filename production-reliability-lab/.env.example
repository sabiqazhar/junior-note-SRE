# Salin ke .env lalu isi. .env TIDAK boleh di-commit (sudah ada di .gitignore).
# Contoh ini aman untuk lab lokal. Jangan pakai nilai ini di mana pun selain lab.

# --- Aplikasi ---
APP_ENV=lab
APP_PORT=8080
LOG_LEVEL=info

# --- PostgreSQL ---
# Ganti password ini. Jangan pakai password yang sama dengan akun lain.
PGUSER=app
PGPASSWORD=ganti-password-ini
PGDATABASE=sre_lab
PGHOST=postgres
PGPORT=5432
# DSN dipakai aplikasi. sslmode=disable cuma untuk lab lokal.
DATABASE_URL=postgres://app:ganti-password-ini@postgres:5432/sre_lab?sslmode=disable

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
OTEL_SERVICE_NAME=sre-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
# Metric name HTTP/DB yang stabil (semconv baru)
OTEL_SEMCONV_STABILITY_OPT_IN=http,database

# --- Backup (minggu 7) ---
# Kosongkan sampai minggu 7; isi dengan kredensial object storage lab.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_CIPHER_PASS=
